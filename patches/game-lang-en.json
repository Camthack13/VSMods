  {
    "op": "replace",
    "path": "/tutorial-firststeps-7",
    "value": "The knife blade still needs a handle. Open your inventory (with <hk>inventorydialog</hk>), to craft a <itemstack type=\"item\">knife-generic-flint*|knife-generic-chert*|knife-generic-granite*|knife-generic-peridotite*|knife-generic-andesite*|knife-generic-basalt*|knife-generic-obsidian*</itemstack> <a href=\"handbooksearch://knife\">knife</a> in your 3x3 crafting grid. Click that link or use the handbook (open with <hk>handbook</hk>) to look up the recipe.",
    "file": "game:lang/en.json"
  }
